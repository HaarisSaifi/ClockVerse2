{
  "name": "clockverse-pro",
  "version": "2.0.0",
  "description": "ClockVerse Recovery Studio: local image recovery and optional version snapshots",
  "scripts": {
    "dev": "npx serve ui -l 5173",
    "serve": "npx serve ui -l 5173",
    "test:sidecar": "python sidecar/test_sidecar.py",
    "test:engine": "cargo test -p clockverse-engine",
    "test:server": "cargo test -p clockverse-license",
    "test": "npm run test:sidecar && npm run test:engine && npm run test:desktop",
    "test:desktop": "cargo test -p clockverse",
    "build:desktop": "cargo build -p clockverse",
    "build:release": "cargo build --release -p clockverse"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
