{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClockVerse",
  "version": "2.0.0",
  "identifier": "com.clockverse.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ClockVerse \u00b7 Recovery Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 650,
        "backgroundColor": "#050508"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
